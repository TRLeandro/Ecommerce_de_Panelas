@startuml ecommerce
class DefaultEntity{
- id : Long
- dataCadastro : LocalDateTime
- version : Integer

}

class Panela{
- modelo : String
- preco : BigDecimal
- peso : Double
- capacidadeLitros : Double
- descricao : String
- isInducao : Boolean
}

class Colecao{
- nome : String
}

class Categoria{
- tipo : String
}

class Cor{
- nome : String
}

abstract Componente{
- peso : Double
- materiais : List<Material>
}

enum Tamanho{
+ PEQUENA
+ MEDIA
+ GRANDE
+ GIGANTE
}

enum TipoSustentacao{
+ CABO
+ ALCA
}
class Fornecedor{
- nome : String
- telefone : String
- cnpj : String
}

class Material{
- nome : String
- qualidades[] : String
}

class Tampa{
- isDePressao : Boolean
}

class Fundo{
- espessura : Double
- isAntiaderente : Boolean
}

class Sustentacao{
- tamanhoEmCm : Integer
- quantidade : Integer
- tipoSustentacao : TipoSustentacao
}

class Usuario{
- nome : String
- sobrenome : String
- login : String
- senhaHash : String
}

enum Perfil{
+ ADMIN
+ FUNCIONARIO
+ CLIENTE
}

class Endereco{
- logradouro : String
- numero : String
- complemento: String
- bairro: String
- cep : String
}

class Cidade{
 - nome: String
}

class Estado {
 - nome: String
 - sigla: String
}

class Regiao {
 - nome: String
}

class ListaDesejo{
}

class Pedido{
- valorItens : BigDecimal
- valorDesconto : BigDecimal
- valorFrete : BigDecimal
+ valorTotal() : BigDecimal
+ pagamentoAtivo() : Optional<Pagamento>
+ pagamentoAprovado() : Optional<Pagamento>
+ marcarComoPago()
+ iniciarSeparacao()
+ marcarComoEnviado()
+ marcarComoEntregue()
+ cancelar()
}

class EnderecoEntrega <<embeddable>> {
- logradouro : String
- numero : String
- complemento : String
- bairro : String
- cidade : String
- estado : String
- cep : String
}

class ItemPedido{
- quantidade : Integer
- valorUnitario : BigDecimal
}

enum StatusPedido{
+ AGUARDANDO_PAGAMENTO
+ PAGO
+ EM_SEPARACAO
+ ENVIADO
+ ENTREGUE
+ CANCELADO
}

class CupomDesconto {
- codigo : String
- percentualDesconto : BigDecimal
- valorDesconto : BigDecimal
- valorMinimoCompra : BigDecimal
- dataValidade : LocalDateTime
- quantidadeDisponivel : Integer
- ativo : boolean
}

class Pagamento{
- valor : BigDecimal
- gateway : String
- gatewayPaymentId : String
- idempotencyKey : String
- motivoRecusa : String
- expiraEm : LocalDateTime
- pagoEm : LocalDateTime
- canceladoEm : LocalDateTime
+ aguardarPagamento(expiraEm)
+ autorizar(codigoAutorizacao)
+ confirmar(quando)
+ recusar(motivo)
+ expirar()
+ cancelar()
+ estornar()
+ contestar()
}

class DadosCartao <<embeddable>> {
- bandeira : String
- ultimos4Digitos : String
- parcelas : Integer
- codigoAutorizacao : String
}

class DadosPix <<embeddable>> {
- qrCodeCopiaECola : String
- qrCodeBase64 : String
- txid : String
}

class DadosBoleto <<embeddable>> {
- linhaDigitavel : String
- codigoBarras : String
- urlPdf : String
- dataVencimento : LocalDate
}

class TransacaoGateway{
- statusGateway : String
- codigoRetorno : String
- mensagem : String
- payloadBruto : String
}

class EventoWebhook{
- gateway : String
- eventoId : String
- recebidoEm : LocalDateTime
- processado : boolean
- payloadBruto : String
}

enum MetodoPagamento{
+ CARTAO_CREDITO
+ CARTAO_DEBITO
+ BOLETO
+ PIX
}

enum StatusPagamento{
+ PENDENTE
+ AGUARDANDO_PAGAMENTO
+ AUTORIZADO
+ PAGO
+ RECUSADO
+ EXPIRADO
+ CANCELADO
+ ESTORNADO
+ CONTESTADO
}

enum TipoTransacao{
+ CRIACAO
+ CONSULTA
+ WEBHOOK
+ ESTORNO
+ CANCELAMENTO
}

interface GatewayPagamento{
+ nome() : String
+ criarCobranca(solicitacao) : ResultadoCobranca
+ consultar(gatewayPaymentId) : ResultadoCobranca
+ estornar(gatewayPaymentId, valor) : ResultadoEstorno
+ cancelar(gatewayPaymentId)
+ interpretarWebhook(corpo, headers) : EventoGateway
}

class GatewayFake{
+ simularPagamento(gatewayPaymentId) : EventoGateway
}


Panela "*" o--> "1" Colecao
Colecao "1" --> "*" Panela
Panela "1" *--> "1" Fundo
Panela "1" *--> "1" Sustentacao
Panela "1" *--> "0..1" Tampa
Panela "*" o--> "1" Fornecedor
Fornecedor "1" --> "*" Panela
Panela "*" --> "1" Tamanho
Panela "*" o--> "1" Categoria
Categoria "1" --> "*" Panela
Panela "*" o--> "1" Cor
Panela "*" o--> "1" Material
ItemPedido "*" --> "1" Panela

Componente <|-up- Tampa
Componente <|-up- Fundo
Componente <|-up- Sustentacao
Componente "*" o-up- "*" Material

Sustentacao "*" -down-> "1" TipoSustentacao

Usuario "*" --> "1" Perfil
Usuario "*" --> "1" Endereco

ListaDesejo "1" --> "1" Usuario
ListaDesejo "*" --> "*" Panela

Pedido "*" --> "1" Usuario
Pedido "1" --> "*" ItemPedido
Pedido "*" --> "1" StatusPedido
Pedido "1" --> "*" Pagamento
Pedido "1" *--> "1" EnderecoEntrega
Pedido "*" --> "0..1" CupomDesconto
Pagamento "*" --> "1" MetodoPagamento
Pagamento "*" --> "1" StatusPagamento
Pagamento "1" *--> "0..1" DadosCartao
Pagamento "1" *--> "0..1" DadosPix
Pagamento "1" *--> "0..1" DadosBoleto
Pagamento "1" *--> "*" TransacaoGateway
TransacaoGateway "*" --> "1" TipoTransacao

GatewayPagamento <|.. GatewayFake
Pagamento ..> GatewayPagamento : cobrado por

Endereco "*" --> "1" Cidade
Cidade "*" --> "1" Estado
Estado "*" --> "1" Regiao

@enduml
